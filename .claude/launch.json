{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "mvn",
      "runtimeArgs": [
        "-f",
        "backend/pom.xml",
        "spring-boot:run"
      ],
      "port": 8080
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "backend-test",
      "runtimeExecutable": "mvn",
      "runtimeArgs": [
        "-f",
        "backend/pom.xml",
        "spring-boot:run",
        "-Dspring-boot.run.arguments=--server.port=8081 --app.seed-data=false"
      ],
      "port": 8081
    },
    {
      "name": "frontend-test",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "vite",
        "frontend",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174,
      "env": {
        "BACKEND_URL": "http://localhost:8081"
      }
    }
  ]
}